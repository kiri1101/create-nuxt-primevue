{
  "name": "create-nuxt-primevue",
  "version": "0.0.0",
  "description": "Create Nuxt 4 + PrimeVue 4 + Tailwind 4 projects on free MIT versions, with a licence check.",
  "keywords": [
    "nuxt",
    "nuxt4",
    "primevue",
    "tailwindcss",
    "tailwind4",
    "starter",
    "create",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiri1101/create-nuxt-primevue.git"
  },
  "homepage": "https://github.com/kiri1101/create-nuxt-primevue#readme",
  "type": "module",
  "license": "MIT",
  "author": "Jordan Tukum Folem",
  "bin": {
    "create-nuxt-primevue": "dist/cli.js"
  },
  "files": [
    "dist",
    "template"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^26.6.6",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1"
  }
}
